# Maintainer: BlackForge contributors

pkgname=blackforge
_python_name=blackforge_cli
pkgver=0.4.0
pkgrel=1
pkgdesc='Safety-minded manager for BlackArch and curated Arch security tools'
arch=('any')
url='https://github.com/johnnypatty/blackforge'
license=('MIT')
depends=('python' 'pacman')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=(
  'sudo: privilege escalation when BlackForge is run by a non-root user'
  'arch-audit: official Arch security advisory checks'
  'snapper: optional Btrfs transaction snapshots'
)
source=("${_python_name}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${_python_name}-${pkgver}.tar.gz")
sha256sums=('f075fbec105403f5cbe1ad68da40ea9a012ed3aabb01c379a60a66e639ce121b')

build() {
  cd "${srcdir}/${_python_name}-${pkgver}"
  python -m build --wheel --no-isolation
  PYTHONPATH=src python -m blackforge completion bash > "${srcdir}/blackforge.bash"
  PYTHONPATH=src python -m blackforge completion zsh > "${srcdir}/_blackforge"
  PYTHONPATH=src python -m blackforge completion fish > "${srcdir}/blackforge.fish"
}

package() {
  cd "${srcdir}/${_python_name}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 docs/blackforge.1 "${pkgdir}/usr/share/man/man1/blackforge.1"
  install -Dm644 packaging/systemd/blackforge-update.service \
    "${pkgdir}/usr/lib/systemd/user/blackforge-update.service"
  install -Dm644 packaging/systemd/blackforge-update.timer \
    "${pkgdir}/usr/lib/systemd/user/blackforge-update.timer"
  install -Dm644 "${srcdir}/blackforge.bash" \
    "${pkgdir}/usr/share/bash-completion/completions/blackforge"
  install -Dm644 "${srcdir}/_blackforge" \
    "${pkgdir}/usr/share/zsh/site-functions/_blackforge"
  install -Dm644 "${srcdir}/blackforge.fish" \
    "${pkgdir}/usr/share/fish/vendor_completions.d/blackforge.fish"
}
