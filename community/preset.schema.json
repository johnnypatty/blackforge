{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://johnnypatty.github.io/blackforge/schemas/community-preset-v1.json",
  "title": "BlackForge community preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "authors", "tags", "packages", "license", "reviewed"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "authors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^@[A-Za-z0-9][A-Za-z0-9-]{0,38}$"}},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"}},
    "packages": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^(blackarch:[A-Za-z0-9@._+-]+|arch:[a-z0-9][a-z0-9._-]*/[A-Za-z0-9@._+-]+)$"}},
    "license": {"enum": ["CC0-1.0", "MIT"]},
    "reviewed": {"type": "boolean"}
  }
}
