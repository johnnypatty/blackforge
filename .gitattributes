* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
PKGBUILD text eol=lf

*.gz binary
*.whl binary

# Keep GitHub release source archives small and avoid a PKGBUILD checksum loop.
/.github export-ignore
/community export-ignore
/docs/releases export-ignore
/packaging/arch export-ignore
/reports export-ignore
/scripts export-ignore
/site export-ignore
/tests export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md export-ignore
